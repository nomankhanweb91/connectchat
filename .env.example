NODE_ENV=production
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u200173730_connectchat
DB_USER=replace-with-hostinger-mysql-user
DB_PASSWORD=replace-with-hostinger-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=30d
CORS_ORIGIN=https://your-domain.example
BCRYPT_ROUNDS=12
ONLINE_THRESHOLD_MINUTES=5
MAX_IMAGE_SIZE_MB=10
IMAGE_UPLOADS_PER_15_MINUTES=10
UPLOAD_STORAGE_DIR=/absolute/path/to/private/persistent/connectchat-uploads
BLOCK_ACTIONS_PER_HOUR=60
REPORTS_PER_HOUR=20
MESSAGE_SENDS_PER_MINUTE=30
